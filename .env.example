# ===== Enterprise Liveness Verification System =====
# Copy this file to `.env` and adjust as needed.

# ---- Backend server ----
APP_NAME="Enterprise Liveness Verification"
APP_VERSION="1.0.0"
API_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# ---- Frontend ----
BACKEND_URL="http://localhost:8000"

# ---- Model storage ----
MODELS_DIR="backend/models"
INSIGHTFACE_MODEL="buffalo_l"

# ---- Inference (CPU-only) ----
ORT_PROVIDERS="CPUExecutionProvider"
DET_SIZE=640

# ---- Decision thresholds (0-100) ----
THRESHOLD_VERIFIED=95
THRESHOLD_HIGH=90
THRESHOLD_MEDIUM=80
THRESHOLD_REVIEW=70

# ---- Identity matching ----
SIMILARITY_THRESHOLD_HIGH=0.40
SIMILARITY_THRESHOLD_LOW=0.30

# ---- Final score weights (must sum to 1.0) ----
WEIGHT_CAPTURE=0.20
WEIGHT_IDENTITY=0.35
WEIGHT_LIVENESS=0.45
